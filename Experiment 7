#include<iostream>
#include<string.h>
using namespace std;

class String
{
    char str[50];

public:
    String()
    {
    str[0] = '\0';
    }
    String(char s[])
    {
    strcpy(str, s);
    }
    ~String()
    {
    cout << "\nDestructor called";
    }

    void accept()
    {
    cout << "Enter a string: ";
    cin >> str;
    }

    void display()
    {
    cout << "String is: " << str;
    }
};

int main()
{
    String s1;
    s1.accept();
    s1.display();
    return 0;
}
