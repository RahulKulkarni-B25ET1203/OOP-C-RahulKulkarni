
#include <iostream>
using namespace std;

class Shape
{
public:
    virtual void area() = 0;

    virtual ~Shape()
    {
    }
};

class Circle : public Shape
{
    float r;

public:
    Circle(float x)
    {
        r = x;
    }

    void area()
    {
        cout << "Area of Circle: " << 3.14 * r * r << endl;
    }
};

class Rectangle : public Shape
{
    float l, b;

public:
    Rectangle(float x, float y)
    {
        l = x;
        b = y;
    }

    void area()
    {
        cout << "Area of Rectangle: " << l * b << endl;
    }
};

int main()
{
    Circle c(5);
    Rectangle r(4, 6);

    Shape *ptr;

    ptr = &c;
    ptr->area();

    ptr = &r;
    ptr->area();

    return 0;
}
