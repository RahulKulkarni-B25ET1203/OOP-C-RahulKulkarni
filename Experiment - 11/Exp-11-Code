
#include <iostream>
#include <string>
using namespace std;


template <class T>
T maximumValue(T a, T b)
{
    return (a > b) ? a : b;
}


template <class T>
class Box
{
    T value;

public:
    Box(T v)
    {
        value = v;
    }

    void display()
    {
        cout << "Value: " << value << endl;
    }
};

int main()
{
    cout << "Maximum Integer: "
         << maximumValue(10, 20) << endl;

    cout << "Maximum Double: "
         << maximumValue(5.5, 3.2) << endl;

    Box<int> b1(100);
    Box<string> b2("goodmorning");

    cout << "Integer Box: ";
    b1.display();

    cout << "String Box: ";
    b2.display();

    return 0;
}
